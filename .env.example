# Application Environment & Port
NODE_ENV=production
PORT=4000

# PostgreSQL Connection String
DATABASE_URL="postgresql://bb_user:SECURE_PASSWORD@127.0.0.1:5432/bb_prod?schema=public"

# Security & Tokens (Generate with: openssl rand -base64 48)
JWT_SECRET="STRONG_64_CHAR_RANDOM_SECRET_KEY_HERE"

# Bootstrap Superadmin Credentials (change password upon first login)
SUPERADMIN_EMAIL="admin@bharatiyabazaar.com"
SUPERADMIN_PASSWORD="SECURE_BOOTSTRAP_PASSWORD_HERE"

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS="https://bharatiyabazaar.com,https://www.bharatiyabazaar.com"
